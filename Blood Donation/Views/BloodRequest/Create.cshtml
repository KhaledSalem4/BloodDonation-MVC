@model Blood_Donation.Models.BloodRequest

@{
    ViewData["Title"] = "طلب دم جديد";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow">
            <div class="card-header bg-danger text-white">
                <h3><i class="fas fa-plus-circle"></i> إنشاء طلب دم جديد</h3>
            </div>
            <div class="card-body">
                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i>
                    <strong>ملاحظة:</strong> يرجى ملء جميع البيانات بدقة لضمان العثور على متبرعين مناسبين في أسرع وقت.
                </div>

                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="BloodTypeNeeded" class="form-label">
                                <i class="fas fa-tint"></i> فصيلة الدم المطلوبة *
                            </label>
                            <select asp-for="BloodTypeNeeded" class="form-select" required>
                                <option value="">-- اختر فصيلة الدم --</option>
                                <option value="A+">A+</option>
                                <option value="A-">A-</option>
                                <option value="B+">B+</option>
                                <option value="B-">B-</option>
                                <option value="AB+">AB+</option>
                                <option value="AB-">AB-</option>
                                <option value="O+">O+</option>
                                <option value="O-">O-</option>
                            </select>
                            <span asp-validation-for="BloodTypeNeeded" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="UrgencyLevel" class="form-label">
                                <i class="fas fa-exclamation-triangle"></i> درجة الإلحاح *
                            </label>
                            <select asp-for="UrgencyLevel" class="form-select" required>
                                <option value="">-- اختر درجة الإلحاح --</option>
                                <option value="Low">عادي</option>
                                <option value="Medium">متوسط</option>
                                <option value="High">عاجل</option>
                            </select>
                            <span asp-validation-for="UrgencyLevel" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="HospitalName" class="form-label">
                                <i class="fas fa-hospital"></i> اسم المستشفى *
                            </label>
                            <input asp-for="HospitalName" class="form-control" placeholder="مثال: مستشفى القاهرة الدولي"
                                required />
                            <span asp-validation-for="HospitalName" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="CityId" class="form-label">
                                <i class="fas fa-map-marker-alt"></i> المدينة *
                            </label>
                            <select asp-for="CityId" class="form-select" asp-items="ViewBag.Cities" required>
                                <option value="">-- اختر المدينة --</option>
                            </select>
                            <span asp-validation-for="CityId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Notes" class="form-label">
                            <i class="fas fa-sticky-note"></i> ملاحظات إضافية
                        </label>
                        <textarea asp-for="Notes" class="form-control" rows="4"
                            placeholder="أي تفاصيل إضافية قد تكون مفيدة..."></textarea>
                        <span asp-validation-for="Notes" class="text-danger"></span>
                    </div>

                    <div class="alert alert-warning">
                        <strong><i class="fas fa-shield-alt"></i> سياسة الخصوصية:</strong>
                        بياناتك الشخصية محمية ولن يتم مشاركتها إلا مع المتبرعين المطابقين للمعايير.
                    </div>

                    <div class="d-grid gap-2 mt-4">
                        <button type="submit" class="btn btn-danger btn-lg">
                            <i class="fas fa-paper-plane"></i> إرسال الطلب
                        </button>
                        <a asp-action="MyRequests" class="btn btn-secondary">
                            <i class="fas fa-times"></i> إلغاء
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}