@{
    ViewData["Title"] = "الصفحة الرئيسية";
}

<style>
    .hero-section {
        background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
        color: white;
        padding: 80px 0;
        border-radius: 20px;
        margin-bottom: 30px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 10px 40px rgba(220, 53, 69, 0.3);
    }

    .hero-section::before {
        content: "";
        position: absolute;
        top: 0;
        right: 0;
        width: 100%;
        height: 100%;
        background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 320"><path fill="%23ffffff" fill-opacity="0.1" d="M0,96L48,112C96,128,192,160,288,160C384,160,480,128,576,112C672,96,768,96,864,112C960,128,1056,160,1152,165.3C1248,171,1344,149,1392,138.7L1440,128L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"></path></svg>') no-repeat bottom;
        background-size: cover;
    }

    .hero-content {
        position: relative;
        z-index: 1;
    }

    .stats-card {
        transition: all 0.3s ease;
        border: none;
        border-radius: 15px;
    }

    .stats-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.15);
    }

    .feature-icon {
        font-size: 3rem;
        margin-bottom: 1rem;
    }

    .cta-button {
        padding: 15px 40px;
        font-size: 1.1rem;
        border-radius: 50px;
        transition: all 0.3s;
        font-weight: 600;
    }

    .cta-button:hover {
        transform: scale(1.05);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    }

    .blood-drop {
        animation: float 3s ease-in-out infinite;
    }

    @@keyframes float {
        0%, 100% {
            transform: translateY(0px);
        }
        50% {
            transform: translateY(-20px);
        }
    }

    .welcome-card {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-radius: 20px;
        padding: 40px;
        margin-bottom: 30px;
        box-shadow: 0 10px 40px rgba(102, 126, 234, 0.3);
    }

    .quick-action-card {
        border: none;
        border-radius: 15px;
        transition: all 0.3s ease;
        cursor: pointer;
        height: 100%;
    }

    .quick-action-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
    }

    .blood-type-badge {
        display: inline-block;
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        font-weight: bold;
        margin: 0 auto 10px;
        box-shadow: 0 5px 15px rgba(220, 53, 69, 0.3);
    }
</style>

@if (User.Identity?.IsAuthenticated == true)
{
    <!-- Welcome Section for Authenticated Users -->
    <div class="welcome-card">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <h1 class="display-5 fw-bold mb-3">
                    <i class="fas fa-hand-holding-heart ms-2"></i>
                    مرحباً بك، @User.Identity.Name
                </h1>
                <p class="lead mb-0">
                    شكراً لانضمامك إلى منصة نَبْضَة. معاً نستطيع إنقاذ الأرواح وصنع الفرق.
                </p>
            </div>
            <div class="col-lg-4 text-center">
                <i class="fas fa-heartbeat" style="font-size: 8rem; opacity: 0.3;"></i>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row g-4 mb-4">
        @if (User.IsInRole("Donor"))
        {
            <div class="col-md-4">
                <a href="@Url.Action("AllRequests", "BloodRequest")" class="text-decoration-none">
                    <div class="card quick-action-card bg-danger text-white">
                        <div class="card-body text-center p-4">
                            <i class="fas fa-hand-holding-medical" style="font-size: 3rem;"></i>
                            <h4 class="mt-3 fw-bold">طلبات التبرع</h4>
                            <p class="mb-0">شاهد جميع طلبات التبرع بالدم</p>
                        </div>
                    </div>
                </a>
            </div>
            <div class="col-md-4">
                <a href="@Url.Action("Profile", "Donor")" class="text-decoration-none">
                    <div class="card quick-action-card bg-primary text-white">
                        <div class="card-body text-center p-4">
                            <i class="fas fa-user-circle" style="font-size: 3rem;"></i>
                            <h4 class="mt-3 fw-bold">ملفي الشخصي</h4>
                            <p class="mb-0">عرض وتحديث بياناتك</p>
                        </div>
                    </div>
                </a>
            </div>
            <div class="col-md-4">
                <a href="@Url.Action("MyDonations", "Donor")" class="text-decoration-none">
                    <div class="card quick-action-card bg-success text-white">
                        <div class="card-body text-center p-4">
                            <i class="fas fa-history" style="font-size: 3rem;"></i>
                            <h4 class="mt-3 fw-bold">تبرعاتي</h4>
                            <p class="mb-0">سجل تبرعاتك السابقة</p>
                        </div>
                    </div>
                </a>
            </div>
        }
        @if (User.IsInRole("Patient"))
        {
            <div class="col-md-6">
                <a href="@Url.Action("Create", "BloodRequest")" class="text-decoration-none">
                    <div class="card quick-action-card bg-danger text-white">
                        <div class="card-body text-center p-4">
                            <i class="fas fa-plus-circle" style="font-size: 3rem;"></i>
                            <h4 class="mt-3 fw-bold">طلب جديد</h4>
                            <p class="mb-0">أنشئ طلب تبرع بالدم</p>
                        </div>
                    </div>
                </a>
            </div>
            <div class="col-md-6">
                <a href="@Url.Action("MyRequests", "BloodRequest")" class="text-decoration-none">
                    <div class="card quick-action-card bg-primary text-white">
                        <div class="card-body text-center p-4">
                            <i class="fas fa-file-medical" style="font-size: 3rem;"></i>
                            <h4 class="mt-3 fw-bold">طلباتي</h4>
                            <p class="mb-0">شاهد طلباتك السابقة</p>
                        </div>
                    </div>
                </a>
            </div>
        }
        @if (User.IsInRole("Admin"))
        {
            <div class="col-md-12">
                <a href="@Url.Action("Dashboard", "Admin")" class="text-decoration-none">
                    <div class="card quick-action-card bg-dark text-white">
                        <div class="card-body text-center p-5">
                            <i class="fas fa-tachometer-alt" style="font-size: 4rem;"></i>
                            <h3 class="mt-3 fw-bold">لوحة التحكم</h3>
                            <p class="mb-0 lead">إدارة النظام والمستخدمين والطلبات</p>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
}
else
{
    <!-- Hero Section for Non-Authenticated Users -->
    <section class="hero-section">
        <div class="container hero-content">
            <div class="row align-items-center">
                <div class="col-lg-6">
                    <h1 class="display-3 fw-bold mb-4">
                        <i class="fas fa-heartbeat blood-drop ms-3"></i>
                        تبرع بالدم.. أنقذ حياة
                    </h1>
                    <p class="lead mb-4">
                        انضم إلى منصة نَبْضَة لربط المتبرعين بالدم مع المحتاجين إليه. كن بطلاً في قصة إنقاذ حياة شخص ما اليوم.
                    </p>
                    <div class="d-flex gap-3 mb-4 flex-wrap">
                        <a href="@Url.Action("Register", "Account")" class="btn btn-light btn-lg cta-button">
                            <i class="fas fa-user-plus ms-2"></i>
                            سجل الآن
                        </a>
                        <a href="@Url.Action("Login", "Account")" class="btn btn-outline-light btn-lg cta-button">
                            <i class="fas fa-sign-in-alt ms-2"></i>
                            تسجيل الدخول
                        </a>
                    </div>
                    <div class="d-flex gap-4 text-white-50 flex-wrap">
                        <div>
                            <i class="fas fa-shield-alt ms-2"></i>
                            آمن وموثوق
                        </div>
                        <div>
                            <i class="fas fa-clock ms-2"></i>
                            متاح 24/7
                        </div>
                        <div>
                            <i class="fas fa-map-marker-alt ms-2"></i>
                            جميع أنحاء مصر
                        </div>
                    </div>
                </div>
                <div class="col-lg-6 text-center d-none d-lg-block">
                    <i class="fas fa-hand-holding-heart blood-drop" style="font-size: 15rem; opacity: 0.2;"></i>
                </div>
            </div>
        </div>
    </section>
}

<!-- Stats Section -->
<section class="mb-4">
    <div class="row g-4">
        <div class="col-md-3 col-sm-6">
            <div class="card stats-card shadow-sm text-center h-100">
                <div class="card-body">
                    <i class="fas fa-users feature-icon text-primary"></i>
                    <h3 class="fw-bold">آلاف المستخدمين</h3>
                    <p class="text-muted mb-0">منصة موثوقة للجميع</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card stats-card shadow-sm text-center h-100">
                <div class="card-body">
                    <i class="fas fa-hand-holding-heart feature-icon text-danger"></i>
                    <h3 class="fw-bold">تبرعات آمنة</h3>
                    <p class="text-muted mb-0">نظام مطابقة ذكي</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card stats-card shadow-sm text-center h-100">
                <div class="card-body">
                    <i class="fas fa-clock feature-icon text-success"></i>
                    <h3 class="fw-bold">استجابة سريعة</h3>
                    <p class="text-muted mb-0">اتصال فوري</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card stats-card shadow-sm text-center h-100">
                <div class="card-body">
                    <i class="fas fa-map-marked-alt feature-icon text-info"></i>
                    <h3 class="fw-bold">تغطية شاملة</h3>
                    <p class="text-muted mb-0">جميع المحافظات</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- How It Works -->
<section class="mb-5">
    <div class="card border-0 shadow-sm" style="border-radius: 20px; overflow: hidden;">
        <div class="card-header bg-gradient text-white text-center" style="background: linear-gradient(135deg, #dc3545 0%, #c82333 100%); padding: 30px;">
            <h2 class="mb-0 fw-bold">
                <i class="fas fa-question-circle ms-2"></i>
                كيف يعمل النظام؟
            </h2>
        </div>
        <div class="card-body p-4">
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="text-center">
                        <div class="bg-danger text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                            style="width: 80px; height: 80px; font-size: 2rem;">
                            <i class="fas fa-user-plus"></i>
                        </div>
                        <h4 class="fw-bold">1. سجل حسابك</h4>
                        <p class="text-muted">أنشئ حساب كمتبرع أو كمريض محتاج للدم</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="text-center">
                        <div class="bg-warning text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                            style="width: 80px; height: 80px; font-size: 2rem;">
                            <i class="fas fa-search"></i>
                        </div>
                        <h4 class="fw-bold">2. ابحث أو انشر طلب</h4>
                        <p class="text-muted">المتبرعون يبحثون عن الطلبات، والمرضى ينشرون احتياجاتهم</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="text-center">
                        <div class="bg-success text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                            style="width: 80px; height: 80px; font-size: 2rem;">
                            <i class="fas fa-handshake"></i>
                        </div>
                        <h4 class="fw-bold">3. تواصل وتبرع</h4>
                        <p class="text-muted">النظام يربط المتبرع المناسب بالمريض المحتاج</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Blood Types Info -->
<section class="mb-5">
    <div class="card border-0 shadow-sm" style="border-radius: 20px; overflow: hidden;">
        <div class="card-header bg-gradient text-white text-center" style="background: linear-gradient(135deg, #c82333 0%, #dc3545 100%); padding: 30px;">
            <h2 class="mb-0 fw-bold">
                <i class="fas fa-tint ms-2"></i>
                فصائل الدم
            </h2>
        </div>
        <div class="card-body p-4">
            <div class="row justify-content-center g-3">
                @foreach (var bloodType in new[] { "A+", "A-", "B+", "B-", "AB+", "AB-", "O+", "O-" })
                {
                    <div class="col-6 col-md-3 col-lg-auto">
                        <div class="blood-type-badge">
                            @bloodType
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@if (User.Identity?.IsAuthenticated != true)
{
    <!-- Call to Action -->
    <section class="mb-4">
        <div class="card border-0 text-white" style="background: linear-gradient(135deg, #dc3545 0%, #c82333 100%); border-radius: 20px; overflow: hidden;">
            <div class="card-body text-center p-5">
                <h2 class="display-4 fw-bold mb-4">هل أنت مستعد لإنقاذ حياة؟</h2>
                <p class="lead mb-4">انضم إلينا الآن وكن جزءًا من مجتمع المتبرعين بالدم في نَبْضَة</p>
                <a href="@Url.Action("Register", "Account")" class="btn btn-light btn-lg cta-button">
                    <i class="fas fa-rocket ms-2"></i>
                    ابدأ الآن مجاناً
                </a>
            </div>
        </div>
    </section>
}