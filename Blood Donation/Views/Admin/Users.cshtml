@model IEnumerable<Blood_Donation.Models.User>
@{
    ViewData["Title"] = "إدارة المستخدمين";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>
            <i class="fas fa-users ms-2"></i>
            إدارة المستخدمين
        </h2>
        <a asp-action="Dashboard" class="btn btn-secondary">
            <i class="fas fa-arrow-right ms-2"></i>
            العودة للوحة التحكم
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle ms-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>الاسم</th>
                            <th>البريد الإلكتروني</th>
                            <th>الهاتف</th>
                            <th>المدينة</th>
                            <th>الدور</th>
                            <th>فصيلة الدم</th>
                            <th>الحالة</th>
                            <th>تاريخ التسجيل</th>
                            <th>الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td>@user.FullName</td>
                                <td>@user.Email</td>
                                <td>@user.PhoneNumber</td>
                                <td>@user.City?.CityName</td>
                                <td>
                                    @if (user.Role == "Admin")
                                    {
                                        <span class="badge bg-danger">مدير</span>
                                    }
                                    else if (user.Role == "Donor")
                                    {
                                        <span class="badge bg-success">متبرع</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info">مريض</span>
                                    }
                                </td>
                                <td>
                                    @if (user.Donor != null)
                                    {
                                        <span class="badge bg-danger">@user.Donor.BloodType</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="badge bg-success">نشط</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">معطل</span>
                                    }
                                </td>
                                <td>@user.CreatedAt.ToString("yyyy/MM/dd")</td>
                                <td>
                                    @if (user.Role != "Admin")
                                    {
                                        <form asp-action="ToggleUserStatus" method="post" class="d-inline">
                                            <input type="hidden" name="userId" value="@user.UserId" />
                                            <button type="submit"
                                                class="btn btn-sm @(user.IsActive ? "btn-warning" : "btn-success")">
                                                <i class="fas @(user.IsActive ? "fa-ban" : "fa-check") ms-1"></i>
                                                @(user.IsActive ? "تعطيل" : "تفعيل")
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>