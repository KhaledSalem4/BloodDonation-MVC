@model IEnumerable<Blood_Donation.Models.BloodRequest>
@{
    ViewData["Title"] = "إدارة الطلبات";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>
            <i class="fas fa-file-medical ms-2"></i>
            إدارة الطلبات
        </h2>
        <a asp-action="Dashboard" class="btn btn-secondary">
            <i class="fas fa-arrow-right ms-2"></i>
            العودة للوحة التحكم
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle ms-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Filter Buttons -->
    <div class="mb-3">
        <a asp-action="Requests" class="btn @(ViewBag.SelectedStatus == null ? "btn-primary" : "btn-outline-primary")">
            الكل
        </a>
        <a asp-action="Requests" asp-route-status="Open"
            class="btn @(ViewBag.SelectedStatus == "Open" ? "btn-success" : "btn-outline-success")">
            المفتوحة
        </a>
        <a asp-action="Requests" asp-route-status="Closed"
            class="btn @(ViewBag.SelectedStatus == "Closed" ? "btn-secondary" : "btn-outline-secondary")">
            المغلقة
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>المريض</th>
                            <th>فصيلة الدم</th>
                            <th>المدينة</th>
                            <th>الأولوية</th>
                            <th>الحالة</th>
                            <th>التاريخ</th>
                            <th>الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var request in Model)
                        {
                            <tr>
                                <td>@request.RequestId</td>
                                <td>@request.Patient?.User?.FullName</td>
                                <td><span class="badge bg-danger">@request.BloodTypeNeeded</span></td>
                                <td>@request.City?.CityName</td>
                                <td>
                                    @if (request.UrgencyLevel == "High")
                                    {
                                        <span class="badge bg-danger">عاجل</span>
                                    }
                                    else if (request.UrgencyLevel == "Medium")
                                    {
                                        <span class="badge bg-warning text-dark">متوسط</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info">عادي</span>
                                    }
                                </td>
                                <td>
                                    @if (request.Status == "Open")
                                    {
                                        <span class="badge bg-success">مفتوح</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">مغلق</span>
                                    }
                                </td>
                                <td>@request.CreatedAt.ToString("yyyy/MM/dd")</td>
                                <td>
                                    @if (request.Status == "Open")
                                    {
                                        <form asp-action="CloseRequest" method="post" class="d-inline">
                                            <input type="hidden" name="requestId" value="@request.RequestId" />
                                            <button type="submit" class="btn btn-sm btn-warning"
                                                onclick="return confirm('هل تريد إغلاق هذا الطلب؟')">
                                                <i class="fas fa-times ms-1"></i>
                                                إغلاق
                                            </button>
                                        </form>
                                    }
                                    <a asp-controller="BloodRequest" asp-action="Details" asp-route-id="@request.RequestId"
                                        class="btn btn-sm btn-info">
                                        <i class="fas fa-eye ms-1"></i>
                                        عرض
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>