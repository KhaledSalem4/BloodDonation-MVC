<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - نَبْضَة</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Blood_Donation.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-gradient-primary shadow-sm sticky-top">
            <div class="container">
                <a class="navbar-brand logo-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <div class="logo-container">
                        <div class="logo-circle">
                            <i class="fas fa-tint"></i>
                        </div>
                        <span class="brand-text">نَبْضَة</span>
                    </div>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="fas fa-home"></i> الرئيسية
                            </a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole("Donor"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link nav-link-custom" asp-controller="BloodRequest" asp-action="AllRequests">
                                        <i class="fas fa-hand-holding-medical"></i> طلبات التبرع
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link nav-link-custom" asp-controller="Donor" asp-action="Profile">
                                        <i class="fas fa-user"></i> ملفي الشخصي
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link nav-link-custom" asp-controller="Donor" asp-action="MyDonations">
                                        <i class="fas fa-history"></i> تبرعاتي
                                    </a>
                                </li>
                            }
                            @if (User.IsInRole("Patient"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link nav-link-custom" asp-controller="BloodRequest" asp-action="MyRequests">
                                        <i class="fas fa-file-medical"></i> طلباتي
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link nav-link-custom" asp-controller="BloodRequest" asp-action="Create">
                                        <i class="fas fa-plus-circle"></i> طلب جديد
                                    </a>
                                </li>
                            }
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link nav-link-custom" asp-controller="Admin" asp-action="Dashboard">
                                        <i class="fas fa-tachometer-alt"></i> لوحة التحكم
                                    </a>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom" asp-controller="Home" asp-action="Privacy">
                                    <i class="fas fa-info-circle"></i> عن نَبْضَة
                                </a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav ms-auto">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle user-dropdown" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <div class="user-avatar">
                                        <i class="fas fa-user-circle"></i>
                                    </div>
                                    <span class="user-name">@User.Identity.Name</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="navbarDropdown">
                                    <li><a class="dropdown-item" href="#"><i class="fas fa-user me-2"></i> الملف الشخصي</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="fas fa-sign-out-alt me-2"></i> تسجيل الخروج
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item me-2">
                                <a class="nav-link btn-login" asp-controller="Account" asp-action="Login">
                                    <i class="fas fa-sign-in-alt"></i> تسجيل الدخول
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link btn-register" asp-controller="Account" asp-action="Register">
                                    <i class="fas fa-user-plus"></i> تسجيل جديد
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    
    <div class="main-content">
        <div class="container">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show custom-alert" role="alert">
                    <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show custom-alert" role="alert">
                    <i class="fas fa-exclamation-circle me-2"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            <main role="main" class="pb-4">
                @RenderBody()
            </main>
        </div>
    </div>

    <footer class="footer bg-gradient-dark text-white mt-5">
        <div class="container py-4">
            <div class="row">
                <div class="col-md-4 text-center text-md-start mb-3 mb-md-0">
                    <div class="footer-logo mb-2">
                        <div class="logo-circle-footer">
                            <i class="fas fa-tint"></i>
                        </div>
                        <span class="brand-text-footer">نَبْضَة</span>
                    </div>
                    <p class="small mb-0">منصة التبرع بالدم الإلكترونية</p>
                </div>
                <div class="col-md-4 text-center mb-3 mb-md-0">
                    <h6 class="text-uppercase fw-bold mb-3">روابط سريعة</h6>
                    <ul class="list-unstyled">
                        <li><a href="#" class="footer-link"><i class="fas fa-angle-left me-2"></i> عن نَبْضَة</a></li>
                        <li><a href="#" class="footer-link"><i class="fas fa-angle-left me-2"></i> اتصل بنا</a></li>
                        <li><a href="#" class="footer-link"><i class="fas fa-angle-left me-2"></i> سياسة الخصوصية</a></li>
                    </ul>
                </div>
                <div class="col-md-4 text-center text-md-end">
                    <h6 class="text-uppercase fw-bold mb-3">تواصل معنا</h6>
                    <div class="social-icons">
                        <a href="#" class="social-icon"><i class="fab fa-facebook-f"></i></a>
                        <a href="#" class="social-icon"><i class="fab fa-twitter"></i></a>
                        <a href="#" class="social-icon"><i class="fab fa-instagram"></i></a>
                        <a href="#" class="social-icon"><i class="fab fa-whatsapp"></i></a>
                    </div>
                </div>
            </div>
            <hr class="my-3 border-light opacity-25">
            <div class="text-center">
                <p class="mb-0 small">
                    &copy; 2026 نَبْضَة | <i class="fas fa-heart text-danger pulse-icon"></i> تبرع بالدم.. أنقذ حياة
                </p>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
