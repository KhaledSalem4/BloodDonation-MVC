@model List<Blood_Donation.Models.DonationHistory>

@{
    ViewData["Title"] = "سجل التبرعات";
}

<div class="card shadow">
    <div class="card-header bg-info text-white">
        <h3><i class="fas fa-history"></i> سجل تبرعاتي</h3>
    </div>
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th><i class="fas fa-calendar"></i> تاريخ التبرع</th>
                            <th><i class="fas fa-hospital"></i> المستشفى</th>
                            <th><i class="fas fa-map-marker-alt"></i> المدينة</th>
                            <th><i class="fas fa-tint"></i> فصيلة الدم</th>
                            <th><i class="fas fa-user-injured"></i> المريض</th>
                            <th><i class="fas fa-exclamation-circle"></i> درجة الإلحاح</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var donation in Model)
                        {
                            <tr>
                                <td>@donation.DonationDate.ToString("yyyy/MM/dd")</td>
                                <td>@donation.BloodRequest.HospitalName</td>
                                <td>@donation.BloodRequest.City?.CityName</td>
                                <td>
                                    <span class="badge bg-danger">@donation.BloodRequest.BloodTypeNeeded</span>
                                </td>
                                <td>@donation.BloodRequest.Patient?.User?.FullName</td>
                                <td>
                                    @if (donation.BloodRequest.UrgencyLevel == "High")
                                    {
                                        <span class="badge bg-danger">عاجل</span>
                                    }
                                    else if (donation.BloodRequest.UrgencyLevel == "Medium")
                                    {
                                        <span class="badge bg-warning">متوسط</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">عادي</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="alert alert-success mt-3">
                <i class="fas fa-trophy"></i>
                لقد قمت بـ <strong>@Model.Count</strong> عملية تبرع حتى الآن! شكراً لك على إنقاذ الأرواح 💚
            </div>
        }
        else
        {
            <div class="alert alert-info text-center">
                <i class="fas fa-info-circle fa-3x mb-3"></i>
                <h5>لم تقم بأي تبرع حتى الآن</h5>
                <p>ابدأ رحلتك في إنقاذ الأرواح!</p>
            </div>
        }

        <div class="mt-3">
            <a asp-action="Profile" class="btn btn-primary">
                <i class="fas fa-arrow-right"></i> العودة للملف الشخصي
            </a>
        </div>
    </div>
</div>